{
  "name": "rajib-tutorial-desktop",
  "productName": "Rajib Tutorial",
  "version": "1.0.0",
  "description": "Rajib Tutorial - Windows desktop app (screenshot-protected)",
  "main": "main.js",
  "author": "raseledutools",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rajibtutorial.desktop",
    "productName": "Rajib Tutorial",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "shell/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raseledutools",
        "repo": "rajib-tutorial-web"
      }
    ]
  }
}
