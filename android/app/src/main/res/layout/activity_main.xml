<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ══ HOME SCREEN — Native/Web বেছে নাও ══ -->
    <LinearLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F8F4F1"
        android:visibility="visible">

        <!-- Logo area -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/ic_launcher_round"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rajib Tutorial"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1E1B18"
                android:layout_marginTop="14dp"
                android:letterSpacing="-0.01"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diploma EEE Courses"
                android:textSize="13sp"
                android:textColor="#9E988F"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <!-- Web Section button -->
            <LinearLayout
                android:id="@+id/btnWebSection"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_web_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp">

                <!-- Icon circle -->
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="@drawable/icon_circle_accent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌐"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Texts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Web Section"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:textColor="#1E1B18"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Courses, Live Class, Exam"
                        android:textSize="12sp"
                        android:textColor="#9E988F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Arrow -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="#E8365D" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="#00000000" />

            <!-- Native Section button -->
            <LinearLayout
                android:id="@+id/btnNativeSection"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_native_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp">

                <!-- Icon circle -->
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="@drawable/icon_circle_dark">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Texts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Native Section"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            android:textColor="#1E1B18"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  Coming Soon"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/badge_soon"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline mode, faster experience"
                        android:textSize="12sp"
                        android:textColor="#9E988F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Arrow -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="#B0A89E" />

            </LinearLayout>

        </LinearLayout>

        <!-- Focus Mode button -->
        <LinearLayout
            android:id="@+id/btnFocusMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/btn_outline_red"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯  Focus Mode"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E8365D"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Version info -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0"
            android:textSize="11sp"
            android:textColor="#C4BDB6"
            android:layout_marginTop="20dp" />

    </LinearLayout>

    <!-- ══ WEBVIEW SECTION ══ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_alignParentTop="true"
                android:max="100"
                android:progress="0"
                android:progressTint="#E8365D"
                android:visibility="gone" />

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/progressBar" />

        </RelativeLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Full-screen video container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- ══ UPDATE BANNER — floating chip top-right ══ -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/update_banner_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="13dp"
        android:elevation="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/updateDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/update_dot" />

        <TextView
            android:id="@+id/updateBannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="নতুন আপডেট"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text=" ↓"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ══ DOWNLOAD PROGRESS OVERLAY ══ -->
    <LinearLayout
        android:id="@+id/downloadOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/download_overlay_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⬇️  আপডেট download হচ্ছে"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E1B18"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/downloadPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E8365D" />

        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/downloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#E8365D"
            android:progressBackgroundTint="#F0EAE6" />

        <!-- Status text -->
        <TextView
            android:id="@+id/downloadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="শুরু হচ্ছে..."
            android:textSize="11.5sp"
            android:textColor="#9E988F"
            android:layout_marginTop="6dp" />

        <!-- Install button — download শেষে দেখাবে -->
        <TextView
            android:id="@+id/btnInstallNow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⬇️  এখনই Install করুন"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/update_banner_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
