<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ══ HOME SCREEN — header + sidebar + cards + footer ══ -->
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Main content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#F3EEFF">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_header"
                android:elevation="8dp">

                <TextView
                    android:id="@+id/btnMenu"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="☰"
                    android:textSize="26sp"
                    android:textColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rajib Tutorial"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓"
                    android:textSize="24sp"
                    android:layout_marginEnd="16dp" />
            </LinearLayout>

            <!-- Body -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="26dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:src="@mipmap/ic_launcher_round" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome 👋"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#2A1B4D"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diploma EEE Courses"
                        android:textSize="13sp"
                        android:textColor="#7A6E99"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="24dp" />

            <LinearLayout
                android:id="@+id/btnWebSection"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_web"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="🌐"
                    android:textSize="22sp"
                    android:background="@drawable/bg_circle_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Web Section"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Courses, Live Class, Exam"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNativeSection"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_native"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="📱"
                    android:textSize="22sp"
                    android:background="@drawable/bg_circle_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Native Section"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faster, smoother native experience"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStudyTools"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_tools"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="🧰"
                    android:textSize="22sp"
                    android:background="@drawable/bg_circle_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Study Tools"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF, Photo &amp; QR tools • Offline"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnFocusMode"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_focus"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="🎯"
                    android:textSize="22sp"
                    android:background="@drawable/bg_circle_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus Mode"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App limits &amp; study focus"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPhoneMode"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_phone"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="📞"
                    android:textSize="22sp"
                    android:background="@drawable/bg_circle_white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Mode"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Only Phone &amp; Messages"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_footer"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© Rajib Tutorial • Diploma in EEE"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0"
                    android:textSize="11sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sidebar (drawer) -->
        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_drawer_head"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="40dp"
                android:paddingBottom="22dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@mipmap/ic_launcher_round" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rajib Tutorial"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diploma EEE Courses"
                    android:textSize="12.5sp"
                    android:textColor="#E6FFFFFF" />
            </LinearLayout>

        <TextView
            android:id="@+id/drawerHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:text="🏠   Home"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2A1B4D"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/drawerWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:text="🌐   Web Section"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2A1B4D"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/drawerNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:text="📱   Native Section"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2A1B4D"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/drawerStudyTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:text="🧰   Study Tools"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2A1B4D"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/drawerFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:text="🎯   Focus Mode"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2A1B4D"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/drawerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:text="📞   Phone Mode"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2A1B4D"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/drawerUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:padding="14dp"
            android:text="🔄   Check for Update"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2A1B4D"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true" />

        </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- ══ WEBVIEW SECTION ══ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_alignParentTop="true"
                android:max="100"
                android:progress="0"
                android:progressTint="#E8365D"
                android:visibility="gone" />

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/progressBar" />

        </RelativeLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Full-screen video container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- ══ UPDATE BANNER — floating chip top-right ══ -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/update_banner_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="13dp"
        android:elevation="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/updateDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/update_dot" />

        <TextView
            android:id="@+id/updateBannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="নতুন আপডেট"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text=" ↓"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ══ DOWNLOAD PROGRESS OVERLAY ══ -->
    <LinearLayout
        android:id="@+id/downloadOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/download_overlay_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⬇️  আপডেট download হচ্ছে"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E1B18"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/downloadPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E8365D" />

        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/downloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#E8365D"
            android:progressBackgroundTint="#F0EAE6" />

        <!-- Status text -->
        <TextView
            android:id="@+id/downloadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="শুরু হচ্ছে..."
            android:textSize="11.5sp"
            android:textColor="#9E988F"
            android:layout_marginTop="6dp" />

        <!-- Install button — download শেষে দেখাবে -->
        <TextView
            android:id="@+id/btnInstallNow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⬇️  এখনই Install করুন"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/update_banner_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
