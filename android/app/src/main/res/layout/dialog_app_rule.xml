<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="দৈনিক সীমা (মিনিট, 0 = সীমা নেই)"
        android:textSize="13sp" android:textColor="#1E1B18" android:layout_marginBottom="8dp"/>
    <NumberPicker android:id="@+id/npDailyLimit"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0E8E4" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="প্রতি ঘণ্টার সীমা (মিনিট, 0 = সীমা নেই)"
        android:textSize="13sp" android:textColor="#1E1B18" android:layout_marginBottom="8dp"/>
    <NumberPicker android:id="@+id/npHourlyLimit"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center"/>
</LinearLayout>
