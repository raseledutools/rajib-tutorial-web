<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F4F1">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/focusBackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎯  Focus Mode"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E1B18"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <LinearLayout android:id="@+id/tabSession"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏱ Session" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#E8365D" />
            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:background="#E8365D" android:id="@+id/tabSessionLine"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/tabApps"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📱 Apps" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#9E988F" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabLock"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔒 Lock" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#9E988F" />
        </LinearLayout>

    </LinearLayout>

    <!-- Pages -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── SESSION PAGE ── -->
        <ScrollView android:id="@+id/pageSession"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <!-- Status card -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/card_web_bg" android:padding="16dp"
                    android:orientation="vertical" android:layout_marginBottom="16dp"
                    android:elevation="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="বর্তমান অবস্থা" android:textSize="12sp" android:textColor="#9E988F"/>
                    <TextView android:id="@+id/sessionStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏸ বন্ধ আছে" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#9E988F"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Timer picker card -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/card_web_bg" android:padding="16dp"
                    android:orientation="vertical" android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Session সময় নির্বাচন করুন"
                        android:textSize="14sp" android:textStyle="bold"
                        android:textColor="#1E1B18" android:layout_marginBottom="12dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <NumberPicker android:id="@+id/pickerHour"
                                android:layout_width="80dp" android:layout_height="wrap_content"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ঘণ্টা" android:textSize="12sp" android:textColor="#9E988F"/>
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=":" android:textSize="24sp" android:textStyle="bold"
                            android:textColor="#1E1B18" android:paddingBottom="20dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <NumberPicker android:id="@+id/pickerMin"
                                android:layout_width="80dp" android:layout_height="wrap_content"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="মিনিট" android:textSize="12sp" android:textColor="#9E988F"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Daily / Hourly radio -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="App সীমা ধরন" android:textSize="13sp"
                        android:textColor="#9E988F" android:layout_marginTop="16dp"/>
                    <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/rbDaily"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="দৈনিক সীমা" android:textColor="#1E1B18" android:checked="true"/>
                        <RadioButton android:id="@+id/rbHourly"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="প্রতি ঘণ্টার সীমা" android:textColor="#1E1B18"
                            android:layout_marginStart="24dp"/>
                    </RadioGroup>
                </LinearLayout>

                <!-- Start button -->
                <TextView android:id="@+id/btnStartSession"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:gravity="center" android:text="Focus Mode শুরু করুন"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/update_banner_bg"
                    android:clickable="true" android:focusable="true"
                    android:elevation="4dp"/>

            </LinearLayout>
        </ScrollView>

        <!-- ── APPS PAGE ── -->
        <ScrollView android:id="@+id/pageApps"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="প্রতিটি app এর পাশে সময় সীমা সেট করুন"
                    android:textSize="13sp" android:textColor="#9E988F"
                    android:layout_marginBottom="8dp" android:layout_marginStart="4dp"/>

                <LinearLayout android:id="@+id/appListContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>

        <!-- ── LOCK PAGE ── -->
        <ScrollView android:id="@+id/pageLock"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <!-- Status -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/card_web_bg" android:padding="16dp"
                    android:orientation="vertical" android:elevation="2dp"
                    android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Lock অবস্থা" android:textSize="12sp" android:textColor="#9E988F"/>
                    <TextView android:id="@+id/lockStatusText"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="কোনো lock নেই" android:textSize="14sp"
                        android:textColor="#1E1B18" android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Self lock card -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/card_web_bg" android:padding="16dp"
                    android:orientation="vertical" android:elevation="2dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🔒  Self-lock" android:textSize="15sp"
                                android:textStyle="bold" android:textColor="#1E1B18"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="নিজের Focus Mode সরাতে PIN লাগবে"
                                android:textSize="12sp" android:textColor="#9E988F"/>
                        </LinearLayout>
                        <Switch android:id="@+id/switchSelfLock"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView android:id="@+id/btnSetSelfPin"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:gravity="center" android:text="Self PIN পরিবর্তন করুন"
                        android:textSize="13sp" android:textColor="#E8365D"
                        android:background="@drawable/btn_outline_red"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

                <!-- Parental control card -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/card_web_bg" android:padding="16dp"
                    android:orientation="vertical" android:elevation="2dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👨‍👩‍👦  Parental Control" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#1E1B18"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="এই PIN ছাড়া Focus Mode সম্পূর্ণ বন্ধ করা যাবে না"
                        android:textSize="12sp" android:textColor="#9E988F"
                        android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>

                    <TextView android:id="@+id/btnSetParentPin"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:gravity="center" android:text="Parental PIN সেট করুন"
                        android:textSize="13sp" android:textColor="#FFFFFF"
                        android:background="@drawable/update_banner_bg"
                        android:clickable="true" android:focusable="true"/>

                    <TextView android:id="@+id/btnClearParentPin"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:gravity="center" android:text="Parental PIN সরান"
                        android:textSize="13sp" android:textColor="#E8365D"
                        android:background="@drawable/btn_outline_red"
                        android:clickable="true" android:focusable="true"
                        android:layout_marginTop="8dp" android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
