<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F0F8F4F1">

    <!-- Blur-like dimmed background -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/overlay_card_bg"
        android:padding="28dp"
        android:elevation="16dp">

        <!-- Lock icon -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔒" android:textSize="48sp" android:layout_marginBottom="12dp"/>

        <!-- App name -->
        <TextView android:id="@+id/overlayAppName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="App বন্ধ" android:textSize="20sp" android:textStyle="bold"
            android:textColor="#1E1B18" android:gravity="center"
            android:fontFamily="sans-serif-medium"/>

        <!-- Sub text -->
        <TextView android:id="@+id/overlaySubText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="এই app এর সময় শেষ হয়ে গেছে।"
            android:textSize="13sp" android:textColor="#9E988F"
            android:gravity="center" android:layout_marginTop="8dp"/>

        <!-- Timer -->
        <TextView android:id="@+id/overlayTimer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#E8365D" android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#F0E8E4" android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"/>

        <!-- Buttons -->
        <TextView android:id="@+id/overlayBtnUnlock"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center" android:text="PIN দিয়ে unlock করুন"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/update_banner_bg"
            android:clickable="true" android:focusable="true"/>

        <TextView android:id="@+id/overlayBtnBack"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:gravity="center" android:text="Home এ যাই"
            android:textSize="13sp" android:textColor="#9E988F"
            android:clickable="true" android:focusable="true"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</LinearLayout>
