<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <EditText android:id="@+id/pinInput1"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="নতুন PIN (৪+ সংখ্যা)" android:inputType="numberPassword"
        android:textSize="16sp" android:gravity="center"
        android:background="@drawable/card_web_bg" android:padding="8dp"
        android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/pinInput2"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="PIN আবার দিন" android:inputType="numberPassword"
        android:textSize="16sp" android:gravity="center"
        android:background="@drawable/card_web_bg" android:padding="8dp"/>
</LinearLayout>
