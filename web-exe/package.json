{
  "name": "rajib-tutorial-web-exe",
  "productName": "Rajib Tutorial",
  "version": "1.0.0",
  "description": "Rajib Tutorial website as a Windows exe (screenshot / screen-record protected)",
  "main": "main.js",
  "author": "raseledutools",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "compression": "maximum",
    "appId": "com.rajibtutorial.webexe",
    "productName": "Rajib Tutorial",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ext-preload.js",
      "extensions.js",
      "safety.js",
      "webtools.js",
      "vidstore.js",
      "offline.html",
      "splash.html",
      "package.json",
      "focus.js",
      "focus-core.js",
      "focus-monitor.ps1",
      "focus-actor.ps1",
      "focus-preload.js",
      "pdfjs/**/*",
      "office/**/*",
      "pdfreader.js",
      "focus.html",
      "extfocus.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Rajib Tutorial",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "RajibTutorial-Setup.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/raseledutools/rajib-tutorial-web/releases/download/web-exe-latest/"
      }
    ],
    "afterPack": "after-pack.js",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": "docx",
        "name": "Word Document",
        "description": "Word Document",
        "role": "Viewer"
      },
      {
        "ext": "xlsx",
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "role": "Viewer"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 Workbook",
        "description": "Excel Workbook",
        "role": "Viewer"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "description": "PowerPoint Presentation",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": "jpg",
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": "jpeg",
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": "gif",
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": "bmp",
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "Video",
        "description": "Video",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "Video",
        "description": "Video",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Video",
        "description": "Video",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "Video",
        "description": "Video",
        "role": "Viewer"
      },
      {
        "ext": "mp3",
        "name": "Audio",
        "description": "Audio",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "Audio",
        "description": "Audio",
        "role": "Viewer"
      },
      {
        "ext": "m4a",
        "name": "Audio",
        "description": "Audio",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "Audio",
        "description": "Audio",
        "role": "Viewer"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer"
      },
      {
        "ext": "txt",
        "name": "Text Document",
        "description": "Text Document",
        "role": "Viewer"
      },
      {
        "ext": "csv",
        "name": "CSV File",
        "description": "CSV File",
        "role": "Viewer"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
