{
  "name": "rajib-tutorial-web-exe",
  "productName": "Rajib Tutorial",
  "version": "1.0.0",
  "description": "Rajib Tutorial website as a Windows exe (screenshot / screen-record protected)",
  "main": "main.js",
  "author": "raseledutools",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rajibtutorial.webexe",
    "productName": "Rajib Tutorial",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Rajib Tutorial",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "RajibTutorial-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raseledutools",
        "repo": "rajib-tutorial-web",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
