{
  "name": "rajib-tutorial-web-exe",
  "productName": "Rajib Tutorial",
  "version": "1.0.0",
  "description": "Rajib Tutorial website as a Windows exe (screenshot / screen-record protected)",
  "main": "main.js",
  "author": "raseledutools",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rajibtutorial.webexe",
    "productName": "Rajib Tutorial",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ext-preload.js",
      "vidstore.js",
      "offline.html",
      "splash.html",
      "package.json",
      "focus.js",
      "focus-core.js",
      "focus.html",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "bin/yt-dlp.exe",
        "to": "yt-dlp.exe",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Rajib Tutorial",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "RajibTutorial-Setup.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/raseledutools/rajib-tutorial-web/releases/download/web-exe-latest/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
