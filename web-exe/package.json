{
  "name": "rajib-tutorial-web-exe",
  "productName": "Rajib Tutorial",
  "version": "1.0.0",
  "description": "Rajib Tutorial website as a Windows exe (screenshot / screen-record protected)",
  "main": "main.js",
  "author": "raseledutools",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rajibtutorial.webexe",
    "productName": "Rajib Tutorial",
    "directories": { "output": "dist" },
    "files": ["main.js", "offline.html", "package.json"],
    "win": {
      "target": "portable",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": { "artifactName": "RajibTutorial.exe" }
  }
}
